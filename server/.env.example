PORT=5000
DATABASE_URL=postgres://codeweft_app:YOUR_APP_PASSWORD@localhost:5432/codeweft_crm
MIGRATION_DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/codeweft_crm
APP_DB_ROLE=codeweft_app
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters
CLIENT_ORIGIN=http://localhost:5173

# Optional: Facebook and Instagram Lead Ads integration through Meta webhooks.
# Keep these secrets only in server/.env. Never put them in client-side variables.
META_VERIFY_TOKEN=choose-your-own-webhook-verification-token
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# Optional: SoftSpark EstateOne Intelligence (Groq). Keep this key server-side only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# Optional commercial integrations. Keep all secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Organization ID that should receive Meta webhook leads (find it in Company & Billing).
META_ORGANIZATION_ID=

# Optional tenant isolation smoke test (set two existing organization IDs).
TENANT_TEST_ORG_ID=
TENANT_TEST_OTHER_ORG_ID=
